{
  "name": "paperflow-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:azure-worker": "node scripts/build-azure-worker.mjs",
    "start:azure-worker": "node dist/azure-worker.cjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "dev:docling": "node scripts/dev-docling.mjs",
    "build:docling": "node scripts/dev-docling.mjs --build",
    "start:docling": "node scripts/dev-docling.mjs --production",
    "setup:docling": "node scripts/setup-docling-local.mjs",
    "test:sidebar": "node scripts/verify-workspace.mjs",
    "test:workspace": "node scripts/verify-workspace.mjs"
  },
  "dependencies": {
    "@azure/identity": "4.13.2",
    "@azure/storage-queue": "12.31.0",
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "gsap": "3.15.0",
    "katex": "0.18.4",
    "lucide-react": "1.35.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "sonner": "2.0.8",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.1",
    "@types/katex": "0.16.8",
    "@types/node": "24.10.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.2",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.3",
    "jsdom": "27.2.0",
    "react-grab": "0.2.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
