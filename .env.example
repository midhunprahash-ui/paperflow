# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Runtime public origin and optional comma-separated trusted legacy origins.
SITE_URL=
AUTH_REDIRECT_ORIGINS=

# Server-only secrets
SUPABASE_SECRET_KEY=sb_secret_...
# PDF validation and Azure output normalization use the Python environment from docling-lab/README.md.
DOCLING_ENABLED=1
# Absolute paths are set automatically by npm run dev:docling
DOCLING_PYTHON=
DOCLING_SCRIPT=

# Defaults to local; use azure-queue in the deployed web app.
DOCLING_DISPATCH_MODE=local
# Azure public-cloud Queue Storage service URL (no SAS or credentials).
AZURE_STORAGE_QUEUE_URL=https://youraccount.queue.core.windows.net
AZURE_DOCLING_QUEUE_NAME=docling
# Client ID of the user-assigned identity attached to each Azure app/job.
AZURE_CLIENT_ID=
# Worker image sets this to its baked-in model directory.
DOCLING_ARTIFACTS_PATH=

# Use the same parser locally and in production. Azure credentials come from
# Azure CLI locally (az login), and managed identity in the hosted worker.
DOCUMENT_PARSER=azure-layout
# Use the production Document Intelligence endpoint for local parity.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
# Optional local-only parser comparison: explicitly set DOCUMENT_PARSER=docling.
# Optional: override the local adapter path.
# AZURE_LAYOUT_SCRIPT=/absolute/path/to/docling-lab/azure_export.py
